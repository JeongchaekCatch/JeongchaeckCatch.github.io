        :root {
            --primary-color: #2563eb;
            --primary-light: #eff6ff;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --bg-light: #f8fafc;
            --border-color: #e2e8f0;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Malgun Gothic', sans-serif; }
        body { color: var(--text-dark); line-height: 1.6; background-color: #fff; }
        
        /* Header */
        header { background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%); color: white; text-align: center; padding: 80px 20px; }
        header h1 { font-size: 2.5rem; margin-bottom: 15px; font-weight: 700; }
        header p { font-size: 1.2rem; opacity: 0.9; max-width: 700px; margin: 0 auto; }

        /* Container */
        .container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }

        /* Section */
        section { margin-bottom: 50px; }
        h2 { font-size: 1.8rem; color: var(--primary-color); border-bottom: 2px solid var(--primary-light); padding-bottom: 10px; margin-bottom: 25px; }
        
        /* Problem Cards */
        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .card { background: var(--bg-light); border: 1px solid var(--border-color); padding: 25px; border-radius: 12px; transition: transform 0.2s; }
        .card:hover { transform: translateY(-3px); }
        .card h3 { margin-bottom: 12px; color: #1e3a8a; font-size: 1.2rem; }

        /* Solution List */
        .solution-item { background: var(--primary-light); border-left: 5px solid var(--primary-color); padding: 20px; margin-bottom: 15px; border-radius: 0 8px 8px 0; }
        .solution-item h3 { color: var(--primary-color); margin-bottom: 8px; }

        /* Business Model Table */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: white; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid var(--border-color); font-size: 0.95rem; }
        th { background-color: var(--primary-color); color: white; }
        tr:last-child td { border-bottom: none; }
        tr:hover { background-color: var(--bg-light); }

        /* Roadmap */
        .roadmap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; }
        .phase-box { background: white; border: 2px solid var(--primary-color); border-radius: 10px; padding: 20px; text-align: center; }
        .phase-box h3 { color: var(--primary-color); margin-bottom: 10px; }

        /* Footer */
        footer { background: #0f172a; color: white; text-align: center; padding: 30px 20px; margin-top: 60px; font-size: 0.9rem; }
    </style>
</head>
